{
  "env": {
    "GIT_AUTHOR_NAME": "ians-agent[bot]",
    "GIT_AUTHOR_EMAIL": "350450150+ians-agent[bot]@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "ians-agent[bot]",
    "GIT_COMMITTER_EMAIL": "350450150+ians-agent[bot]@users.noreply.github.com"
  },
  "permissions": {
    "allow": [
      "Bash(bun run gate)",
      "Bash(bun run gate *)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun run typecheck)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run format)",
      "Bash(bun run specs:check)",
      "Bash(bun run specs:graph)",
      "Bash(bun run specs:find *)",
      "Bash(bun run specs:trace *)",
      "Bash(bun run pr:body *)",
      "Bash(bun run agent:push)",
      "Bash(bun run agent:whoami)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh issue edit*--add-label*)",
      "Bash(gh issue edit*--remove-label*)",
      "Bash(gh label*)",
      "Bash(gh api*labels*)",
      "Bash(gh api*/merge*)",
      "Bash(gh api*protection*)",
      "Bash(gh api*rulesets*)",
      "Bash(gh api* -X*)",
      "Bash(gh api*--method*)",
      "Bash(gh api* -f *)",
      "Bash(gh api* -F *)",
      "Bash(gh api*--field*)",
      "Bash(gh api*--input*)",
      "Bash(*GH_TOKEN=*)",
      "Bash(bun run agent:token*)",
      "Bash(*ian-agent/private-key*)",
      "Read(~/.config/ian-agent/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Read(/.env)",
      "Read(/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.sh start", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.sh stop",
            "timeout": 600,
            "statusMessage": "Running the gate…"
          }
        ]
      }
    ]
  }
}
