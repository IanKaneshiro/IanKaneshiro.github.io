{
  "name": "iankaneshiro.github.io",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gate": "bun tools/gate/cli.ts",
    "gate:protection": "bun tools/gate/cli.ts --only protection",
    "format": "prettier --write .",
    "lint": "eslint . && stylelint \"**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --allow-empty-input --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "specs:check": "bun tools/specs/cli.ts check",
    "specs:graph": "bun tools/specs/cli.ts graph",
    "specs:review": "bun tools/specs/review/server.ts",
    "specs:trace": "bun tools/specs/cli.ts trace",
    "specs:find": "bun tools/specs/cli.ts find",
    "pr:body": "bun tools/gate/pr-body.ts",
    "agent:gh": "bun tools/agent/cli.ts gh",
    "agent:push": "bun tools/agent/cli.ts push",
    "agent:token": "bun tools/agent/cli.ts token",
    "agent:whoami": "bun tools/agent/cli.ts whoami"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "prettier-plugin-astro": "^1.1.2"
  }
}
