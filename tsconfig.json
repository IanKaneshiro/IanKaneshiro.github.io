{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tools/**/*.ts",
    "tests/**/*.ts",
    "packages/*/build.ts",
    "packages/*/src/**/*.ts",
    "packages/*/.storybook/*.ts"
  ]
}
