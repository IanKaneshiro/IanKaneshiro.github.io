{
  "font": {
    "family": {
      "$type": "fontFamily",
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
        "$description": "Headings, labels and code."
      },
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Body text."
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "md is 16px; md and up follow a 1.25 ratio, rounded to whole pixels. Output in rem.",
      "xs": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "sm": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "xl": {
        "$value": {
          "value": 25,
          "unit": "px"
        }
      },
      "2xl": {
        "$value": {
          "value": 31,
          "unit": "px"
        }
      },
      "3xl": {
        "$value": {
          "value": 39,
          "unit": "px"
        }
      },
      "4xl": {
        "$value": {
          "value": 49,
          "unit": "px"
        }
      },
      "5xl": {
        "$value": {
          "value": 61,
          "unit": "px"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.7
      }
    }
  }
}
